{
  "name": "carkeeper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "ocr-assets": "node scripts/ocr-assets.mjs",
    "predev": "npm run ocr-assets",
